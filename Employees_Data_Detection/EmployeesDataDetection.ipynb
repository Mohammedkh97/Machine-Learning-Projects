    "image_path = r\"C:\\Users\\Admin\\Downloads\\Main\\Machine-Learning-Projects\\Employees_Data_Detection\\EmployeesData\\output_images\\عقد عمل دوام كامل استقدام من الخارج.jpg\"\n",
