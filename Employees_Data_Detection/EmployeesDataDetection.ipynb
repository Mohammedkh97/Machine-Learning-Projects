    "def extract_clean_json(parsed: dict) -> str:\n",
    "    doc_type = parsed.get(\"document_type\")\n",
    "\n",
    "    # Keep the root key\n",
    "    result = {\"document_type\": doc_type}\n",
    "\n",
    "    # Map document types to the corresponding fields\n",
    "    field_map = {\n",
    "        \"EMPLOYMENT CONTRACT FULL WORK\": \"contract_details\",\n",
    "        \"eVisa - Tourism\": \"visa_details\",\n",
    "        \"eVisa - Employment\": \"visa_details\",\n",
    "        \"Residence\": \"residence_details\",\n",
    "        \"Change Status\": \"change_status_details\",\n",
    "        \"Passport\": \"passport_details\",\n",
    "        \"Healthcare Professional Registration Certificate\": \"healthcare_details\",\n",
    "    }\n",
    "\n",
    "    target_field = field_map.get(doc_type)\n",
    "    if target_field and parsed.get(target_field):\n",
    "        result[target_field] = parsed[target_field]\n",
    "\n",
    "    return json.dumps(result, indent=4)"
   ]
